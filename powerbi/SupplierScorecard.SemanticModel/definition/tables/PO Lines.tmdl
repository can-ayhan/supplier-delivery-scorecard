	partition 'PO Lines' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase, [CreateNavigationProperties = false]),
				    Data = Source{[Schema = "mart", Item = "fact_po_line"]}[Data],
				    #"Selected Columns" = Table.SelectColumns(Data, {"po_line_key", "po_number", "po_item", "supplier_key", "material_key", "plant_key", "order_date_key", "due_date_key", "delivery_date_key", "uom", "ordered_qty", "received_qty", "returned_qty", "order_value_eur", "receipt_count", "planned_lead_time_days", "lead_time_days", "days_late", "is_due", "is_delivery_complete", "is_on_time", "is_in_full", "is_otif", "delivery_status"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Selected Columns", {{"po_line_key", Int64.Type}, {"po_number", type text}, {"po_item", Int64.Type}, {"supplier_key", Int64.Type}, {"material_key", Int64.Type}, {"plant_key", Int64.Type}, {"order_date_key", Int64.Type}, {"due_date_key", Int64.Type}, {"delivery_date_key", Int64.Type}, {"uom", type text}, {"ordered_qty", type number}, {"received_qty", type number}, {"returned_qty", type number}, {"order_value_eur", Currency.Type}, {"receipt_count", Int64.Type}, {"planned_lead_time_days", Int64.Type}, {"lead_time_days", Int64.Type}, {"days_late", Int64.Type}, {"is_due", type logical}, {"is_delivery_complete", type logical}, {"is_on_time", type logical}, {"is_in_full", type logical}, {"is_otif", type logical}, {"delivery_status", type text}}),
				    #"Added Lateness Bucket" = Table.AddColumn(#"Changed Type", "Lateness Bucket", each
				        if [days_late] = null then "Not delivered"
				        else if [days_late] <= 0 then "On time or early"
				        else if [days_late] <= 3 then "1-3 days late"
				        else if [days_late] <= 7 then "4-7 days late"
				        else if [days_late] <= 14 then "8-14 days late"
				        else "15+ days late", type text),
				    #"Added Bucket Order" = Table.AddColumn(#"Added Lateness Bucket", "Lateness Bucket Order", each
				        if [days_late] = null then 6
				        else if [days_late] <= 0 then 1
				        else if [days_late] <= 3 then 2
				        else if [days_late] <= 7 then 3
				        else if [days_late] <= 14 then 4
				        else 5, Int64.Type),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Bucket Order", {{"po_line_key", "PO Line Key"}, {"po_number", "PO Number"}, {"po_item", "PO Item"}, {"supplier_key", "Supplier Key"}, {"material_key", "Material Key"}, {"plant_key", "Plant Key"}, {"order_date_key", "Order Date Key"}, {"due_date_key", "Due Date Key"}, {"delivery_date_key", "Delivery Date Key"}, {"uom", "UoM"}, {"ordered_qty", "Ordered Qty"}, {"received_qty", "Received Qty"}, {"returned_qty", "Returned Qty"}, {"order_value_eur", "Order Value EUR"}, {"receipt_count", "Receipt Count"}, {"planned_lead_time_days", "Planned Lead Time Days"}, {"lead_time_days", "Lead Time Days"}, {"days_late", "Days Late"}, {"is_due", "Is Due"}, {"is_delivery_complete", "Closed by Buyer"}, {"is_on_time", "Is On Time"}, {"is_in_full", "Is In Full"}, {"is_otif", "Is OTIF"}, {"delivery_status", "Delivery Status"}})
				in
				    #"Renamed Columns"

