# Copy to .env and adjust if needed. These match docker-compose.yml.
PGHOST=localhost
PGPORT=5433
PGDATABASE=scorecard
PGUSER=scorecard
PGPASSWORD=scorecard

# Read-only login for the text-to-SQL assistant (created by sql/07_assistant_role.sql)
PGREADER_USER=scorecard_reader
PGREADER_PASSWORD=reader

# Only needed for `scorecard ask` and `scorecard eval`.
# A key from the free tier at console.groq.com is enough.
GROQ_API_KEY=
# The Groq model the assistant should use, one that supports tool use. Required, there is no default.
SCORECARD_MODEL=
